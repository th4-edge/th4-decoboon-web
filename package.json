{
  "name": "th4-decoboon-web",
  "version": "3.0.73",
  "private": true,
  "description": "装得清 · 家装企业全角色 Web 经营工作台（V3 重建）",
  "type": "module",
  "scripts": {
    "check:client-copy": "node scripts/check-client-copy.mjs",
    "check:brand-theme": "node scripts/audit-web-brand-theme.mjs",
    "audit:actions": "node scripts/audit-business-actions.mjs --report",
    "audit:concepts": "node scripts/audit-business-concepts.mjs --report",
    "audit:enums": "node scripts/audit-business-enums.mjs --report",
    "audit:forms": "node scripts/audit-web-form-picker.mjs",
    "audit:forms:write": "node scripts/audit-web-form-picker.mjs --write",
    "audit:menus": "node scripts/report-role-menus.mjs",
    "audit:menus:report": "node scripts/audit-web-workbench-governance.mjs --mode=workbenches --report --menu-report",
    "audit:metrics": "node scripts/audit-business-metrics.mjs --report",
    "audit:page-system": "node scripts/audit-business-page-system.mjs --report",
    "audit:permissions": "node scripts/audit-business-permissions.mjs --report",
    "audit:states": "node scripts/audit-business-states.mjs --report",
    "audit:workbenches": "node scripts/audit-web-workbench-governance.mjs --mode=workbenches --report",
    "audit:workspaces": "node scripts/audit-web-workbench-governance.mjs --mode=workspaces --report",
    "build": "npm run check:pagination && npm run check:contract-range-pagination && npm run check:forms:self-test && npm run check:forms && npm run type-check && npm run check:shell-layout && npm run check:client-copy && npm run check:ai-flavor && npm run check:identifier-exposure && npm run check:brand-theme && vite build",
    "build:analyze": "npm run type-check && vite build --mode production",
    "check:actions": "node scripts/audit-business-actions.mjs",
    "check:concepts": "node scripts/audit-business-concepts.mjs",
    "check:enums": "node scripts/audit-business-enums.mjs",
    "check:forms": "node scripts/audit-web-form-picker.mjs --check",
    "check:forms:self-test": "node scripts/audit-web-form-picker.mjs --self-test",
    "check:metrics": "node scripts/audit-business-metrics.mjs",
    "check:page-system": "node scripts/audit-business-page-system.mjs",
    "check:permissions": "node scripts/audit-business-permissions.mjs",
    "check:states": "node scripts/audit-business-states.mjs",
    "check:workbenches": "node scripts/audit-web-workbench-governance.mjs --mode=workbenches",
    "check:workspaces": "node scripts/audit-web-workbench-governance.mjs --mode=workspaces",
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "check:store-scope": "node scripts/audit-store-scope-guard.mjs",
    "check:pagination": "node scripts/check-list-pagination.mjs",
    "check:contract-range-pagination": "node scripts/check-contract-range-pagination.mjs",
    "check:contract-range-pagination:self-test": "node scripts/check-contract-range-pagination.mjs --self-test",
    "check:shell-layout": "node scripts/audit-web-shell-layout.mjs",
    "check:ai-flavor": "node scripts/audit-web-ai-flavor.mjs",
    "check:ai-flavor:self-test": "node scripts/audit-web-ai-flavor.mjs --self-test",
    "check:identifier-exposure": "node scripts/audit-web-identifier-exposure.mjs",
    "check:identifier-exposure:self-test": "node scripts/audit-web-identifier-exposure.mjs --self-test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "echarts": "^5.5.0",
    "element-plus": "^2.9.7",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "5.0.4",
    "sass": "^1.85.0",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "5.2.8",
    "vue-tsc": "^2.2.12"
  }
